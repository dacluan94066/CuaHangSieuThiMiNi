{
  "name": "ql-sieu-thi-mini-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Ứng dụng minh họa MongoDB QLSieuThiMini, chỉ đọc dữ liệu",
  "type": "module",
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "start": "node server.js",
    "start:test": "node server.js --test",
    "test:unit": "node --test tests/products-inventory.test.js tests/transactions-customers.test.js",
    "test:store:unit": "node --test tests/store-security.test.js tests/store-contract.test.js tests/store-routes.test.js tests/store-registration.test.js",
    "test:store:api": "node --test tests/store-api.test.js",
    "test:shop:unit": "node --test tests/store-catalog-cart.test.js",
    "test:shop:api": "node --test tests/store-catalog-cart-api.test.js",
    "test:checkout:unit": "node --test tests/store-checkout.test.js",
    "test:checkout:api": "node --test tests/store-checkout-api.test.js",
    "test:orders:unit": "node --test tests/store-orders.test.js",
    "test:orders:api": "node --test tests/store-orders-api.test.js",
    "benchmark:scrypt": "node scripts/benchmark-scrypt.js",
    "test:admin:unit": "node --test tests/admin-analytics.test.js",
    "test:admin:auth": "node --test --test-concurrency=1 tests/admin-auth.test.js",
    "test:admin:api": "node --test tests/admin-readonly-api.test.js",
    "test:regression": "node --test tests/products-inventory.test.js tests/transactions-customers.test.js tests/store-security.test.js tests/store-contract.test.js tests/store-routes.test.js tests/store-registration.test.js tests/store-catalog-cart.test.js tests/store-checkout.test.js tests/store-orders.test.js"
  },
  "dependencies": {
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "mongodb": "7.5.0"
  }
}
